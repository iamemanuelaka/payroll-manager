name: Validate Python

on:
  push:
  pull_request:

jobs:
  syntax:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Compile application modules
        run: |
          python -m py_compile \
            payroll_app/main.py \
            payroll_app/charts.py \
            payroll_app/data_models.py \
            payroll_app/pdf_generator.py
